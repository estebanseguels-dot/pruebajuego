; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that change here are too many and
; some can be edited by other means.

[application]
config/name="Retro RPG Adventure"
config/version="0.1.0"
run/main_scene="res://src/scenes/main.tscn"

[autoload]
GameManager="*res://src/managers/game_manager.gd"
SceneLoader="*res://src/core/scene_loader.gd"

[physics]
common/physics_ticks_per_second=60
2d/physics_engine="GodotPhysics2D"

[rendering]
anti_aliasing/screen_space_antialiasing_mode=0
textures/canvas_textures/hdri_mode=0
