; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Retro RPG Adventure"
config/version="0.1.0"
run/main_scene="res://src/scenes/main.tscn"
config/features=PackedStringArray("4.6")

[autoload]

GameManager="*res://src/core/game_manager.gd"
SceneLoader="*res://src/core/scene_loader.gd"
DataManager="*res://src/core/data_manager.gd"
TextBoxConfig="*res://src/systems/text_box_config.gd"

[physics]

2d/physics_engine="GodotPhysics2D"

[rendering]

anti_aliasing/screen_space_antialiasing_mode=0
textures/canvas_textures/hdri_mode=0
